ENV=local

MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/schedular
MONGO_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/schedular

# Public URL of THIS backend — used to build the LinkedIn OAuth redirect_uri,
# so it must exactly match the "Authorized redirect URL" in the LinkedIn app.
BACKEND_URL_LOCAL=http://localhost:5000
BACKEND_URL_PROD=https://your-api-domain.com

FRONTEND_URL_LOCAL=http://localhost:5173
FRONTEND_URL_PROD=https://your-frontend-domain.com

PORT=5000
JWT_SECRET=replace-with-a-strong-random-secret

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GenAI — text generation (captions/hashtags/hooks), OpenAI-SDK-compatible.
# Swap AI_BASE_URL to point at a different OpenAI-compatible provider:
#   Groq (free):  AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   OpenAI:       AI_BASE_URL=(leave empty)                    AI_MODEL=gpt-4o-mini
#   Together AI:  AI_BASE_URL=https://api.together.xyz/v1      AI_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
AI_API_KEY=your-ai-provider-api-key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# GenAI — image generation (Google Gemini, via Google AI Studio: aistudio.google.com)
GENAI_API_KEY=your-gemini-api-key
GENAI_IMAGE_MODEL=gemini-2.5-flash-image
PROMPT_AI_MODEL=gemini-2.5-flash
